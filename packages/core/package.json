{
  "name": "@yumml/core",
  "version": "0.1.0",
  "description": "The yumml recipe language: parser, schema validation and semantic checks",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "yumml-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema/yumml-v1.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2"
  }
}
